# Copiar como .env y ajustar valores locales. Ver app/core/config.py.
DATABASE_URL=mysql+pymysql://usuario:password@localhost:3306/humworld

# TODO(equipo): validar estos valores por defecto (ver ADR-002, TODOs en config.py)
CAPTURA_PERIODICIDAD_MINUTOS=30
CAPTURA_TIMEOUT_CONEXION_SEGUNDOS=5.0
CAPTURA_TIMEOUT_LECTURA_SEGUNDOS=10.0
CAPTURA_MAX_REINTENTOS=3
CAPTURA_CONCURRENCIA_MAXIMA=10
CIRCUIT_BREAKER_UMBRAL_FALLOS=5

# CORS (ADR-005): orígenes del frontend separados por coma
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173

# Cálculo de humor (HU-SENT-002-v2): valores propuestos, pendientes de ratificar
SENTIMIENTO_TIMEOUT_ML_SEGUNDOS=3.0
SENTIMIENTO_BARRIDO_MINUTOS=30
SENTIMIENTO_BARRIDO_LOTE=500

# Purgado de noticias (HU-ADMIN-002). La caducidad vigente se cambia con PUT /api/v1/config.
PURGADO_CADUCIDAD_DIAS_DEFECTO=90
PURGADO_INTERVALO_HORAS=24

# Modelo de ML (HU-SENT-006, ADR-004). Vacía = ML desactivado (solo diccionario).
# La clave es personal del equipo: nunca la subas al repositorio.
GEMINI_API_KEY=
ML_UMBRAL_ENTRENAMIENTO=1000
ML_DIRECTORIO_MODELOS=modelos
